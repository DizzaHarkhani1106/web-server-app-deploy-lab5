@using Assignment1_CarRental.Controllers
@model Customer
@{
    ViewData["Title"] = "Edit Customer";
}

<h2>Edit Customer</h2>

<form method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="form-group">
        <label>Customer Name</label>
        <input type="text" name="name" value="@Model.Name" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input type="email" name="email" value="@Model.Email" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Phone</label>
        <input type="text" name="phone" value="@Model.Phone" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Address</label>
        <input type="text" name="address" value="@Model.Address" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Update</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary mt-2">Cancel</a>
</form>
