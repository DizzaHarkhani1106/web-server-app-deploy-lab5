@using Assignment1_CarRental.Controllers
@model List<Inventory>
@{
    ViewData["Title"] = "Inventory Management";
}

<h2>Inventory Management</h2>

<form method="post">
    <div class="form-group">
        <label>Item Name</label>
        <input type="text" name="name" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Quantity</label>
        <input type="number" name="quantity" class="form-control" required />
    </div>
    <div class="form-group">
        <label>Price</label>
        <input type="number" name="price" step="0.01" class="form-control" required />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Add Inventory</button>
</form>

<hr />

@if (!Model.Any())
{
    <p>No inventory items found.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Quantity</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>
                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-warning btn-sm">Edit</a>
                        <a href="@Url.Action("Delete", new { id = item.Id })" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure?');">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
