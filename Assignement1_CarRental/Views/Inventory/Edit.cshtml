@using Assignment1_CarRental.Controllers
@model Inventory
@{
    ViewData["Title"] = "Edit Inventory";
}

<h2>Edit Inventory</h2>

<form method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="form-group">
        <label>Item Name</label>
        <input type="text" name="name" value="@Model.Name" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Quantity</label>
        <input type="number" name="quantity" value="@Model.Quantity" class="form-control" required />
    </div>

    <div class="form-group">
        <label>Price</label>
        <input type="number" name="price" value="@Model.Price" step="0.01" class="form-control" required />
    </div>

    <button type="submit" class="btn btn-primary mt-2">Update</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary mt-2">Cancel</a>
</form>
