{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiKeySettings": {
    "ApiKey": "car-rental-secret-key-12345",
    "HeaderName": "X-API-Key"
  },
  "ReverseProxy": {
    "Routes": {
      "customer-route": {
        "ClusterId": "customer-cluster",
        "Match": {
          "Path": "/api/customers/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/customers/{**catch-all}"
          }
        ]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/api/inventories/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/inventories/{**catch-all}"
          }
        ]
      },
      "vehicle-inventory-route": {
        "ClusterId": "vehicle-inventory-cluster",
        "Match": {
          "Path": "/vehicle-inventory/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/{**catch-all}"
          }
        ]
      },
      "maintenance-route": {
        "ClusterId": "maintenance-cluster",
        "Match": {
          "Path": "/api/repairhistory/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/repairhistory/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "customer-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://customerapi:8080"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://maintenanceapi:8080"
          }
        }
      },
      "vehicle-inventory-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://vehicleinventory:8080"
          }
        }
      },
      "maintenance-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://maintenanceapi:8080"
          }
        }
      }
    }
  }
}